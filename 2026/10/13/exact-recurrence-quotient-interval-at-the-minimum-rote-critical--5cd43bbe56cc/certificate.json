{"Q_recurrence":"Q_0=1, Q_1=a_1+1, Q_N=2Q_{N-1}+Q_{N-2}, a_1 in {1,3}.","accumulation_interval":"[3+sqrt(2),5+3sqrt(2)]","claim":"For each of the two minimum-critical-exponent complementary-symmetric Rote languages, the accumulation set of R_v(m)/m is [3+sqrt(2),5+3sqrt(2)].","lower_recurrence_quotient":"3+sqrt(2)","ratio_limit":"Q_{N+1}/Q_N -> 1+sqrt(2).","recurrence_quotient":"5+3sqrt(2)","schema_version":1,"source":{"date":"2020-03-15","identifier":"arXiv:2003.06916v1","primary_msc":"68R15"},"source_recurrence_formula":"For Q_N<=n<Q_{N+1}, R_v(n+1)=n+3Q_{N+1}+Q_N."}
