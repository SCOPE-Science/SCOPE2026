{
  "title": "Integral cellular certificate for H_6(exp_6(S^2); Z)",
  "conventions": {
    "cell_order": "For each total point count j=1,...,6, compositions are ordered by the increasing bit-mask convention implemented in verify_cellular_certificate.py; each eligible tau cell precedes its tilde_tau cell.",
    "tau_cells": "A based cell tau(S) is present for compositions S of j with 1<=j<=5.",
    "tilde_cells": "An unbased cell tilde_tau(S) is present for compositions S of j with 1<=j<=6.",
    "dimension": "dim(tau(S))=dim(tilde_tau(S))=sum(S)+len(S).",
    "boundary": {
      "decrement": "For each even entry s_a, let S_down_a decrease that entry by one. Put p_a=sum_{i<a}s_i. In d(tau(S)), its coefficient is (-1)^(p_a+1). In d(tilde_tau(S)), the coefficients are 2*(-1)^(p_a+1) on tau(S_down_a) and (-1)^p_a on tilde_tau(S_down_a).",
      "merge": "For adjacent entries s_a,s_(a+1), merge them to form mu_a(S). The coefficient on the same cell type is (-1)^(sum(S)+a-1) times the signed shuffle number [s_a+s_(a+1) choose s_a] at q=-1.",
      "q_binomial": "For n even and r odd it is 0; for n even and r even it is binom(n/2,r/2); for n odd it is binom(floor(n/2),floor(r/2))."
    }
  },
